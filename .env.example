# Postgres connection
DATABASE_URL=postgresql://albdata:albdata@localhost:5432/albdata
# Public URL of the app (used for tracking pixels, click + unsubscribe links)
APP_URL=http://localhost:3000
# Random 32+ char strings (install.sh generates these)
SESSION_SECRET=change-me-session-secret-at-least-32-chars
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars
# Optional: hostname used in SMTP HELO when verifying emails (should resolve to this server)
VERIFY_HELO=mail.example.com
